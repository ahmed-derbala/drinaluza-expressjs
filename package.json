{
  "name": "drinaluza-server",
  "version": "1.6.14",
  "main": "src/main.js",
  "description": "Drinaluza, business manager (backend server)",
  "author": "Ahmed Derbala <derbala.ahmed531992@gmail.com>",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmed-derbala/drinaluza-expressjs"
  },
  "keywords": [
    "drinaluza"
  ],
  "imports": {
    "#config/*": "./src/config/*.js",
    "#config": "./src/config/index.js",
    "#core/*": "./src/core/*",
    "#auth/*": "./src/core/auth/*.js",
    "#auth": "./src/core/auth/index.js",
    "#error": "./src/core/error/index.js",
    "#files/*": "./src/core/files/*",
    "#files": "./src/core/files/index.js",
    "#health/*": "./src/core/health/*",
    "#health": "./src/core/health/index.js",
    "#helpers/*": "./src/core/helpers/*",
    "#enum": "./src/core/helpers/enum.js",
    "#helpers": "./src/core/helpers/index.js",
    "#core": "./src/core/index.js",
    "#log": "./src/core/log/index.js",
    "#mongodb/*": "./src/core/mongodb/*.js",
    "#mongodb": "./src/core/mongodb/index.js",
    "#slug": "./src/core/mongodb/slug-plugin.js",
    "#notifications/*": "./src/core/notifications/*",
    "#notifications": "./src/core/notifications/index.js",
    "#schemas/*": "./src/core/schemas/*",
    "#schemas": "./src/core/schemas/index.js",
    "#scripts/*": "./src/core/scripts/*",
    "#scripts": "./src/core/scripts/index.js",
    "#sessions/*": "./src/core/sessions/*",
    "#sessions": "./src/core/sessions/index.js",
    "#shared/*": "./src/core/shared/*",
    "#shared": "./src/core/shared/index.js",
    "#json/*": "./src/core/shared/json/*",
    "#json": "./src/core/shared/json/index.js",
    "#socketio/*": "./src/core/socketio/*",
    "#socketio": "./src/core/socketio/index.js",
    "#swagger/*": "./src/core/swagger/*",
    "#swagger": "./src/core/swagger/index.js",
    "#utils/*": "./src/core/utils/*",
    "#utils": "./src/core/utils/index.js",
    "#validation": "./src/core/validation/index.js",
    "#features/*": "./src/features/*",
    "#businesses/*": "./src/features/businesses/*",
    "#businesses": "./src/features/businesses/index.js",
    "#restaurants/*": "./src/features/businesses/restaurants/*",
    "#restaurants": "./src/features/businesses/restaurants/index.js",
    "#tabouna-stand/*": "./src/features/businesses/tabouna-stand/*",
    "#tabouna-stand": "./src/features/businesses/tabouna-stand/index.js",
    "#dashboard/*": "./src/features/dashboard/*",
    "#dashboard": "./src/features/dashboard/index.js",
    "#default-products/*": "./src/features/default-products/*",
    "#default-products": "./src/features/default-products/index.js",
    "#feed/*": "./src/features/feed/*",
    "#feed": "./src/features/feed/index.js",
    "#features": "./src/features/index.js",
    "#index/*": "./src/features/index/*",
    "#index": "./src/features/index/index.js",
    "#orders/*": "./src/features/orders/*",
    "#orders": "./src/features/orders/index.js",
    "#products/*": "./src/features/products/*",
    "#products": "./src/features/products/index.js",
    "#purchases/*": "./src/features/purchases/*",
    "#purchases": "./src/features/purchases/index.js",
    "#reviews/*": "./src/features/reviews/*",
    "#reviews": "./src/features/reviews/index.js",
    "#subschemas/*": "./src/features/reviews/subschemas/*",
    "#subschemas": "./src/features/reviews/subschemas/index.js",
    "#sales/*": "./src/features/sales/*",
    "#sales": "./src/features/sales/index.js",
    "#search/*": "./src/features/search/*",
    "#search": "./src/features/search/index.js",
    "#users/*": "./src/features/users/*",
    "#users": "./src/features/users/index.js"
  },
  "scripts": {
    "env:prod": "cp -n .env.prod .env",
    "env:prod-reset": "cp .env.prod .env",
    "env:local": "cp .env.local .env",
    "env:reset": "cp .env.sample .env",
    "build:prod": "npm run clean:prod",
    "build:prod-run": "npm run build:prod && npm run start:prod",
    "build:local": "npm run clean",
    "bootstrap:local": "npm run env:reset && npm run env:local && npm run build:local && npm run dev",
    "bootstrap:prod": "npm run env:reset && npm run env:prod-reset && npm run build:prod",
    "smenu": "npm run env:local && NODE_ENV=local node src/core/scripts/smenu.js",
    "smenu:prod": "npm run env:prod-reset && NODE_ENV=production node src/core/scripts/smenu.js",
    "start": "node src/main.js",
    "start:prod": "NODE_ENV=production node src/main.js",
    "start:prod-pm2": "npm run i:prod && NODE_ENV=production pm2 start --name drinaluza src/main.js -i max --node-args='--max-old-space-size=8192' -f",
    "start:prod-pm2-monit": "npm run start:prod-pm2 && pm2 monit",
    "start:local": "npm run env:local && NODE_ENV=local node src/main.js",
    "start:local-pm2": "pm2 start src/config/pm2.config.js --env local && pm2 monit",
    "dev": "npm run env:local && NODE_ENV=local node --watch-path=./src src/main.js",
    "dev:prod": "npm run env:prod && NODE_ENV=production node --watch-path=./src src/main.js",
    "dev:debug": "npm run env:local && NODE_ENV=local NODE_DEBUG=module node --trace-warnings --stack-trace-limit=100 --watch-path=./src src/main.js",
    "reload": "pm2 reload drinaluza",
    "stop": "pm2 stop all",
    "delete": "pm2 delete all",
    "monit": "pm2 monit",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx}\"",
    "push": "npm run format && git add . && git commit -m",
    "postpush": "git push && npm run ver",
    "pushd": "npm run push",
    "pull": "git pull origin main && npm run i && npm run dev",
    "i": "npm i -g npm-check-updates && npm i",
    "i:prod": "NODE_ENV=production npm i --omit=dev",
    "fix": "npm audit fix --force",
    "rm:local": "rm -rf logs node_modules package-lock.json",
    "rm:prod": "rm -rf node_modules package-lock.json",
    "clean": "npm run rm:local && npm run i",
    "clean:prod": "npm run rm:prod && npm run i:prod",
    "update": "npm run ncu && npm run clean",
    "ncu": "npm-check-updates --peer -u",
    "ver": "npm version patch --no-git-tag-version",
    "sync:barrels": "npm run env:local && NODE_ENV=local node src/core/scripts/sync-barrels.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cli-color": "^2.0.4",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "expo-server-sdk": "^7.2.0",
    "express": "^5.2.1",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^8.7.0",
    "express-useragent": "^2.2.3",
    "express-validator": "^7.3.2",
    "express-winston": "^4.2.0",
    "glob": "^13.0.6",
    "helmet": "^8.3.0",
    "inquirer": "^14.2.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.9.5",
    "mongoose-unique-validator": "^6.1.1",
    "morgan": "^1.12.0",
    "multer": "^2.3.0",
    "prettier": "^3.9.6",
    "socket.io": "^4.8.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-mongodb": "^7.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0"
  }
}
